{
  "start-scene": "menu",

  "window": {
    "title": "Default Game Window",
    "size": {
      "width": 1280,
      "height": 720
    },
    "fullscreen": false
  },

  "scene": {
    "renderer": {
      "sky": "assets/textures/sky.jpg",
      "postprocess": "assets/shaders/postprocess/vignette.frag"
    },

    "assets": {
      "shaders": {
        "tinted": {
          "vs": "assets/shaders/tinted.vert",
          "fs": "assets/shaders/tinted.frag"
        },
        "textured": {
          "vs": "assets/shaders/textured.vert",
          "fs": "assets/shaders/textured.frag"
        }
      },

      "textures": {
        "moon": "assets/textures/moon.jpg",
        "grass": "assets/textures/grass_ground_d.jpg",
        "wood": "assets/textures/wood.jpg",
        "glass": "assets/textures/glass-panels.png",
        "monkey": "assets/textures/monkey.png",
        "museum-armoury": "assets/textures/museum/Armoury0.jpg",
        "museum-billiard": "assets/textures/museum/Billiard_Room0.jpg",
        "museum-dining": "assets/textures/museum/Dining_Room0.jpg",
        "museum-great": "assets/textures/museum/Great_Drawing_Room0.jpg",
        "museum-morning": "assets/textures/museum/Morning_Room0.jpg",
        "museum-porcelain": "assets/textures/museum/Porcelain_Room0.jpg",
        "museum-serving": "assets/textures/museum/Serving_Room0.jpg",
        "museum-small": "assets/textures/museum/Small_Drawing_Room0.jpg",
        "museum-smoking": "assets/textures/museum/Smooking_Room0.jpg",
        "museum-vestibule": "assets/textures/museum/Upper_Vestibule0.jpg",
        "hall-tex-1": "assets/textures/NHMHintzeHall02_Model_9_u1_v1_diffuse.jpeg",
        "hall-tex-2": "assets/textures/NHMHintzeHall02_Model_9_u2_v1_diffuse.jpeg"


      },

      "meshes": {
        "cube": "assets/models/cube.obj",
        "monkey": "assets/models/monkey.obj",
        "plane": "assets/models/plane.obj",
        "sphere": "assets/models/sphere.obj",
        "museum": "assets/models/Museum.obj",
        "hall": "assets/models/NHMHintzeHall01.obj"


      },

      "samplers": {
        "default": {},
        "pixelated": { "MAG_FILTER": "GL_NEAREST" },
        "anisotropic": {
          "MIN_FILTER": "GL_LINEAR_MIPMAP_LINEAR",
          "MAG_FILTER": "GL_LINEAR",
          "MAX_ANISOTROPY": 16
        },
        "mipmap-linear": {
          "MIN_FILTER": "GL_LINEAR_MIPMAP_LINEAR",
          "MAG_FILTER": "GL_LINEAR"
        }


      },

      "materials": {

        "hall-flat": {
          "type": "textured",
          "shader": "textured",
          "pipelineState": {
            "faceCulling": { "enabled": false },
            "depthTesting": { "enabled": true }
          },
          "tint": [ 1, 1, 1, 1 ],
          "texture": "hall-tex-1",
          "sampler": "mipmap-linear"
        },







        "metal": {
          "type": "tinted",
          "shader": "tinted",
          "pipelineState": {
            "faceCulling": { "enabled": false },
            "depthTesting": { "enabled": true }
          },
          "tint": [ 0.45, 0.4, 0.5, 1 ]
        },

        "glass": {
          "type": "textured",
          "shader": "textured",
          "pipelineState": {
            "faceCulling": { "enabled": false },
            "depthTesting": { "enabled": true },
            "blending": {
              "enabled": true,
              "sourceFactor": "GL_SRC_ALPHA",
              "destinationFactor": "GL_ONE_MINUS_SRC_ALPHA"
            },
            "depthMask": false
          },
          "transparent": true,
          "tint": [ 1, 1, 1, 1 ],
          "texture": "glass",
          "sampler": "pixelated"
        },

        "grass": {
          "type": "textured",
          "shader": "textured",
          "pipelineState": {
            "faceCulling": { "enabled": false },
            "depthTesting": { "enabled": true }
          },
          "tint": [ 1, 1, 1, 1 ],
          "texture": "grass",
          "sampler": "default"
        },

        "monkey": {
          "type": "textured",
          "shader": "textured",
          "pipelineState": {
            "faceCulling": { "enabled": false },
            "depthTesting": { "enabled": true }
          },
          "tint": [ 1, 1, 1, 1 ],
          "texture": "monkey",
          "sampler": "default"
        },

        "moon": {
          "type": "textured",
          "shader": "textured",
          "pipelineState": {
            "faceCulling": { "enabled": false },
            "depthTesting": { "enabled": true }
          },
          "tint": [ 1, 1, 1, 1 ],
          "texture": "moon",
          "sampler": "default"
        }
      }
    },

    "world": [
      {
        "name": "PlayerCamera",
        "position": [ 0, 1.5, 10 ],
        "rotation": [ 0, 0, 0 ],
        "components": [
          { "type": "Camera" },
          { "type": "Free Camera Controller" }
        ],
        "children": [

        ]
      },
      {
        
          "name": "Hall",
          "position": [ 0, -1, -10 ],
          "scale": [ 0.5, 0.5, 0.5 ],
          "components": [
            {
              "type": "Mesh Renderer",
              "mesh": "hall",
              "material": "hall-flat"
            }
          ]
        }
    ]
  }
}
